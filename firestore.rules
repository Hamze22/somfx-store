rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hamze.zakarie@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin'];
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
             data.price is number &&
             data.type in ['ea', 'indicator', 'course'];
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.amount is number &&
             data.status in ['pending', 'completed', 'failed'];
    }

    function isValidPromo(data) {
      return data.code is string &&
             data.discount is number &&
             data.type in ['percentage', 'fixed'];
    }

    function isValidFavorite(data) {
      return data.productId is string && isValidId(data.productId);
    }

    // --- Collections ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());

      // Favorites subcollection
      match /favorites/{productId} {
        allow read, write: if isOwner(userId) && isValidFavorite(incoming() || existing());
      }
    }

    // Products
    match /products/{productId} {
      allow read: if true; 
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update, delete: if isAdmin();
    }

    // Promocodes
    match /promocodes/{promoId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidPromo(incoming());
      allow delete: if isAdmin();
    }

    // Simple Admin Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
  }
}
